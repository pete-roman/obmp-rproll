<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the roll logic (parser, roll, chat format, HUD filter). Never shipped: the mod folder
    only gets projects with a ModSide. Run with: dotnet test .\RpRoll\RpRoll.slnx
  -->

  <PropertyGroup>
    <AssemblyName>RpRoll.Tests</AssemblyName>
    <RootNamespace>RpRoll.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Server\RpRoll.Server.csproj" />
    <!-- The server references Common without copying it (the mod folder gets it from Common), so the tests do. -->
    <ProjectReference Include="..\Common\RpRoll.Common.csproj" />
    <!-- The client project pulls in the game-side SDK, so only its SDK-free filter is compiled in here. -->
    <Compile Include="..\Client\RollLineFilter.cs" Link="Client\RollLineFilter.cs" />
  </ItemGroup>

</Project>
